# Copy to .env for local development (never commit .env).

# --- Database ---
# Local (default): SQLite file inside prisma/
DATABASE_URL="file:dev.sqlite"

# Docker / Render SQLite (absolute path inside the container):
# DATABASE_URL="file:/app/prisma/dev.sqlite"

# Production on Render with Postgres (recommended):
# 1) Change prisma/schema.prisma provider to "postgresql"
# 2) Replace migrations with Postgres ones (see README)
# 3) Set:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# --- Shopify (injected by `shopify app dev`; set manually on Render) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products
SHOPIFY_APP_URL=https://localhost

# --- Optional: CalicoDesk API overrides ---
# CALICODESK_API_BASE_URL=https://calicodesk.com/api/v1
# CALICODESK_SIGNIN_PATH=/wordpress/sign-in
# CALICODESK_WORKSPACES_PATH=/me/workspaces

# --- Runtime (Render sets PORT automatically) ---
# PORT=3000
# NODE_ENV=production
