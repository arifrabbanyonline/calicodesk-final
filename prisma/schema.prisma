// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Local + single-instance deploy: SQLite via DATABASE_URL (see .env.example).
// For Render with a managed Postgres DB, change provider to "postgresql" and
// set DATABASE_URL to the Render connection string (see README).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Stores the CalicoDesk connection for each shop that installs the app.
// One row per shop. The developer token is obtained from CalicoDesk at
// sign-in; the merchant's password is never stored.
model CalicoDeskConnection {
  shop              String   @id
  email             String?
  developerToken    String
  // JSON-encoded array of workspaces synced from CalicoDesk.
  workspaces        String   @default("[]")
  activeWorkspaceId String?
  activeSubdomain   String?
  shopifySyncedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
